{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/commit-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
